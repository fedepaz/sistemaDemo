{
  "name": "vivero-client-alpha",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Agricultural Management System",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "turbo run build",
    "start": "concurrently \"pnpm --filter frontend start\" \"pnpm --filter backend start:prod\"",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:migrate:test": "dotenv -e .env.test pnpm --filter backend prisma migrate deploy",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "turbo": "^2.8.9"
  },
  "pnpm": {
    "overrides": {
      "defu": ">=6.1.5",
      "glob": "11.1.0",
      "validator": "13.15.22",
      "jws": "3.2.3",
      "esbuild": "0.25.0",
      "@nestjs/common": ">=11.1.18",
      "@nestjs/core": ">=11.1.18",
      "vite": "7.3.2",
      "postcss": ">=8.5.10",
      "next-intl": ">=4.9.1",
      "js-yaml": ">=4.3.0",
      "shell-quote": ">=1.9.0",
      "sharp": ">=0.35.0",
      "body-parser": ">=2.3.0",
      "@xhmikosr/decompress": ">=10.2.1",
      "piscina": ">=4.9.3",
      "ws": ">=8.21.0",
      "fast-uri": ">=3.1.4",
      "turbo": ">=2.9.14",
      "@babel/core": ">=7.29.6",
      "@eslint/plugin-kit": "0.3.4",
      "hono": ">=4.12.27",
      "file-type": ">=21.3.2",
      "lodash": "4.18.1",
      "@isaacs/brace-expansion": ">=5.0.7",
      "brace-expansion": ">=5.0.7",
      "yauzl": ">=3.2.1",
      "webpack": ">=5.104.1",
      "qs": ">=6.15.2",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "multer": ">=2.2.0",
      "serialize-javascript": ">=7.0.5",
      "@hono/node-server": ">=2.0.10",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "effect": "3.21.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4": "4.0.4",
      "path-to-regexp": "8.4.2"
    }
  }
}
