# ============================================================
# EXAMPLE environment file — DO NOT use these values in production.
#
# This file only documents which variables the backend expects.
# Real values live in the server's local `.env` (gitignored), including:
#   - CORS_ORIGINS  (the actual origins the deployed frontend uses)
#   - JWT_SECRET / JWT_REFRESH_SECRET  (must be strong, unique secrets)
#   - DATABASE_* connection strings
#   - DEFAULT_PASSWORD  (only used by the admin seed, change after seeding)
#
# Copy to `.env` locally and fill with real values:
#   cp .env.example .env
# ============================================================

BACKEND_NODE_ENV=development
PORT=3001
URL=http://localhost:3001

# Real origins of the deployed frontend go here (e.g. https://proplanta-sistema.ar)
CORS_ORIGINS=http://localhost:3000

# --- Primary database (Prisma/MariaDB) ---
DATABASE_PROD_NAME=replace_me
DATABASE_PROD_HOST=replace_me
DATABASE_PROD_PORT=3306
DATABASE_PROD_USERNAME=replace_me
DATABASE_PROD_PASSWORD=replace_me

DATABASE_PROD_URL="mysql://user:password@host:3306/db_name"

# --- Local dev database ---
DATABASE_DEV_NAME=replace_me
DATABASE_DEV_HOST=localhost
DATABASE_DEV_PORT=3306
DATABASE_DEV_USERNAME=replace_me
DATABASE_DEV_PASSWORD=replace_me

DATABASE_DEV_URL="mysql://user:password@localhost:3306/db_name"

# --- Legacy database (raw mysql2 access) ---
DATABASE_LEGACY_NAME=martin3
DATABASE_LEGACY_HOST=localhost
DATABASE_LEGACY_PORT=3307
DATABASE_LEGACY_USERNAME=replace_me
DATABASE_LEGACY_PASSWORD=replace_me

DATABASE_LEGACY_URL="mysql://user:password@localhost:3307/martin3"

# Generate real secrets, e.g.:  openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_of_32_plus_chars
JWT_EXPIRES_IN=45m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_REFRESH_EXPIRES_IN=12h

# --- Optional integrations (leave empty if unused) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SENDGRID_API_KEY=

# --- Seeding ---
# Default tenant ID used when seeding the first admin
DEFAULT_TENANT_ID=12345678-1234-1234-1234-123456789012
# Temporary password for the admin seed — CHANGE IT after the first login
DEFAULT_PASSWORD=replace_me
