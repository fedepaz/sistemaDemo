// prisma/schema/enums.prisma

/// Enum for the type of action performed in an audit log.
enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  ACCESS
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PROFILE_UPDATE
  MFA_ENABLE
  MFA_DISABLE
}

/// Enum for the types of entities that can be audited.
enum EntityType {
  USER
  TENANT
  ROLE
  LOCALE
  MESSAGE
  USER_PREFERENCE
  AUDIT_LOG
  UNKNOWN
}

enum PermissionType {
  CRUD
  PROCESS
  READ_ONLY
}